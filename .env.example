# UAP Invaders Environment Configuration Example
# Copy this file to .env and configure as needed

# Application Configuration
# UAP_INVADERS_DEBUG=1
# UAP_INVADERS_CONFIG_DIR=/custom/path/to/config

# Game Settings
# UAP_INVADERS_DIFFICULTY=normal  # Options: easy, normal, hard, expert

# Development Settings
# NODE_ENV=development
# DEV_SERVER_PORT=55377
# ELECTRON_DEBUG_PORT=60205
# ELECTRON_INSPECT_PORT=63365

# Build Configuration
# ELECTRON_BUILDER_ALLOW_UNRESOLVED_DEPENDENCIES=true

# Logging
# LOG_LEVEL=info  # Options: error, warn, info, debug, trace
