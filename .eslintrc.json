{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "commonjs"
  },
  "rules": {
    "indent": ["error", 2],
    "linebreak-style": ["error", "unix"],
    "quotes": ["error", "single", { "avoidEscape": true }],
    "semi": ["error", "always"],
    "no-unused-vars": ["warn"],
    "no-console": "off",
    "max-len": ["warn", { "code": 100, "ignoreUrls": true }]
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "build/",
    "archive/",
    "*.min.js"
  ]
}
